<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/student_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF4FA"
    tools:context=".StudentHomeActivity">

    <!-- Background -->
    <ImageView
        android:id="@+id/student_home_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Campus background"
        android:scaleType="centerCrop"
        android:src="@drawable/campus_background"
        android:alpha="0.12" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EEF4FA" />

    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/student_home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/student_home_logo"
                    android:layout_width="140dp"
                    android:layout_height="58dp"
                    android:contentDescription="Campus Companion Logo"
                    android:scaleType="fitStart"
                    android:src="@drawable/campus_logo" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Notification -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <TextView
                        android:id="@+id/notification_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/student_back_circle"
                        android:contentDescription="Notifications"
                        android:gravity="center"
                        android:text="🔔"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/notification_badge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:background="#E53935"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- Avatar -->
                <TextView
                    android:id="@+id/student_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/student_back_circle"
                    android:gravity="center"
                    android:text="ST"
                    android:textColor="#1687D9"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- GREETING -->
            <TextView
                android:id="@+id/student_home_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Good day, Student! 👋"
                android:textColor="#102D63"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/student_home_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ready to make today count?"
                android:textColor="#52678F"
                android:textSize="15sp" />

            <!-- SEARCH -->
            <LinearLayout
                android:id="@+id/home_search_bar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="17dp"
                android:background="@drawable/student_login_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="Search"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#123B7A" />

                <TextView
                    android:id="@+id/search_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Search courses, notes, events..."
                    android:textColor="#62749A"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- IMPORTANT NOTICES / HERO -->
            <FrameLayout
                android:id="@+id/hero_card"
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:layout_marginTop="18dp"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Campus"
                    android:scaleType="centerCrop"
                    android:src="@drawable/campus_background" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#B5164A91" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <View
                        android:layout_width="55dp"
                        android:layout_height="3dp"
                        android:background="#E53935" />

                    <TextView
                        android:id="@+id/hero_notice_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="●  IMPORTANT NOTICE"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hero_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="ICT361 Group Lab Submission"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/hero_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Check your group requirements and submission details."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/explore_button"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/student_button"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="View Notice"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

            <!-- QUICK ACCESS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quick Access"
                    android:textColor="#102D63"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/see_all_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All  ›"
                    android:textColor="#1687D9"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ROW 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/my_classes_card"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/student_login_panel"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📖"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="My Classes"
                        android:textColor="#102D63"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/timetable_card"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/student_login_panel"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Timetable"
                        android:textColor="#102D63"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ROW 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/assignments_card"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/student_login_panel"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Assignments"
                        android:textColor="#102D63"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/study_groups_card"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/student_login_panel"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👥"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Lab Groups"
                        android:textColor="#102D63"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- TODAY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Today"
                    android:textColor="#102D63"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/today_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Schedule"
                    android:textColor="#687A9B"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- SCHEDULE CARD -->
            <LinearLayout
                android:id="@+id/today_schedule_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Class 1 -->
                <LinearLayout
                    android:id="@+id/class_one"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/class_one_time"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="08:00\n- 10:00"
                        android:textColor="#102D63"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="52dp"
                        android:background="#1687D9" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="11dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/class_one_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ICT361 - Mobile Application Programming"
                            android:textColor="#102D63"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/class_one_lecturer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Lecturer: Mr Nyirenda"
                            android:textColor="#687A9B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/class_one_venue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Venue: Old DH"
                            android:textColor="#1687D9"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#102D63"
                        android:textSize="24sp"
                        android:gravity="center" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8EDF4" />

                <!-- Class 2 -->
                <LinearLayout
                    android:id="@+id/class_two"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/class_two_time"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="14:00\n- 16:00"
                        android:textColor="#102D63"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="52dp"
                        android:background="#E53935" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="11dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/class_two_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ICT261 - Database Systems"
                            android:textColor="#102D63"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/class_two_lecturer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Lecturer: Mr Nyirenda"
                            android:textColor="#687A9B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/class_two_venue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Venue: NLT"
                            android:textColor="#1687D9"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#102D63"
                        android:textSize="24sp"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

            <!-- MOTIVATION -->
            <LinearLayout
                android:id="@+id/motivation_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="92dp"
                android:layout_marginTop="16dp"
                android:background="#FFF0F3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#FFE0E6"
                    android:gravity="center"
                    android:text="“"
                    android:textColor="#E53935"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/motivation_quote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Progress feels better than perfection."
                        android:textColor="#102D63"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Keep going — Campus Companion"
                        android:textColor="#52678F"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:background="#FFE8EC"
                android:gravity="center"
                android:text="⌂"
                android:textColor="#E53935"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#E53935"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CHAT -->
        <LinearLayout
            android:id="@+id/nav_chat"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="💬"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="#687A9B"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- RESOURCES -->
        <LinearLayout
            android:id="@+id/nav_resources"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="📁"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resources"
                android:textColor="#687A9B"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#687A9B"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>