<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:contentDescription="Lecturer profile, notifications, and settings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Lecturer profile header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/lecturer_profile_header"
            android:contentDescription="Lecturer profile">

            <TextView
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="55sp"
                android:background="@drawable/lecturer_avatar"
                android:elevation="5dp"
                android:contentDescription="Lecturer profile avatar" />

            <TextView
                android:id="@+id/tvLecturerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Lecturer Name"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:accessibilityHeading="true"
                android:contentDescription="Lecturer name" />

            <TextView
                android:id="@+id/tvLecturerNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="LECT001 - LECTURER"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:contentDescription="Lecturer identification number and role" />

        </LinearLayout>

        <!-- Notifications -->
        <LinearLayout
            android:id="@+id/notificationsOption"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Notifications. Opens notification settings">

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="♧"
                android:textColor="#548DE8"
                android:textSize="32sp"
                android:gravity="center"
                android:contentDescription="Notifications icon"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:text="Notifications"
                android:textColor="#333333"
                android:textSize="18sp"
                android:accessibilityHeading="true"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#888888"
                android:textSize="30sp"
                android:contentDescription="Open notifications"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:contentDescription="Section divider"
            android:importantForAccessibility="no" />

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/settingsOption"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Settings. Opens application settings">

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textColor="#548DE8"
                android:textSize="32sp"
                android:gravity="center"
                android:contentDescription="Settings icon"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:text="Settings"
                android:textColor="#333333"
                android:textSize="18sp"
                android:accessibilityHeading="true"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#888888"
                android:textSize="30sp"
                android:contentDescription="Open settings"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:contentDescription="Section divider"
            android:importantForAccessibility="no" />

    </LinearLayout>

</ScrollView>
