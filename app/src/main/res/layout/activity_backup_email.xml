<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/backup_email_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF4FA">

    <ScrollView
        android:id="@+id/backup_email_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="30dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/backup_email_back_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Go back"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:tint="#1687D9" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BACKUP EMAIL"
                        android:textColor="#1687D9"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Add another way to recover your account"
                        android:textColor="#687A9B"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- RED UNDERLINE -->
            <View
                android:layout_width="76dp"
                android:layout_height="3dp"
                android:layout_marginStart="52dp"
                android:layout_marginTop="4dp"
                android:background="#E53935" />

            <!-- INTRO CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#E6F3FF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#D5ECFF"
                    android:gravity="center"
                    android:text="✉"
                    android:textColor="#1687D9"
                    android:textSize="23sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Why add a backup email?"
                        android:textColor="#1687D9"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="A backup email gives you another recovery option if you cannot access your primary email."
                        android:textColor="#687A9B"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- CURRENT BACKUP EMAIL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Current Backup Email"
                android:textColor="#102D63"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/student_login_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <TextView
                    android:id="@+id/current_backup_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Not added"
                    android:textColor="#777777"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/backup_email_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not verified"
                    android:textColor="#E57C00"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- NEW BACKUP EMAIL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="New Backup Email"
                android:textColor="#102D63"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="#687A9B"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/backup_email_input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/transparent"
                    android:hint="example@email.com"
                    android:inputType="textEmailAddress"
                    android:padding="0dp"
                    android:textColor="#222222"
                    android:textColorHint="#9AA4B2"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- CONFIRM EMAIL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm Backup Email"
                    android:textColor="#687A9B"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/confirm_backup_email_input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/transparent"
                    android:hint="Re-enter your email address"
                    android:inputType="textEmailAddress"
                    android:padding="0dp"
                    android:textColor="#222222"
                    android:textColorHint="#9AA4B2"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- VERIFICATION NOTICE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email Verification"
                    android:textColor="#1687D9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="After you save, Campus Companion will ask you to verify the backup email before it becomes active."
                    android:textColor="#687A9B"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- SAVE -->
            <Button
                android:id="@+id/save_backup_email_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#1687D9"
                android:text="SAVE BACKUP EMAIL"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- REMOVE -->
            <Button
                android:id="@+id/remove_backup_email_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FDECEE"
                android:text="REMOVE BACKUP EMAIL"
                android:textColor="#E53935"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- CANCEL -->
            <Button
                android:id="@+id/cancel_backup_email_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E9F4FC"
                android:text="CANCEL"
                android:textColor="#1687D9"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- FOOTER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Keep your recovery information up to date."
                android:textColor="#687A9B"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>