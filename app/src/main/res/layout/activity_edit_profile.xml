<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edit_profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF4FA">

    <ScrollView
        android:id="@+id/edit_profile_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="30dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/edit_profile_back_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Go back"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:tint="#1687D9" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EDIT PROFILE"
                        android:textColor="#1687D9"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Keep your student information up to date"
                        android:textColor="#687A9B"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="68dp"
                android:layout_height="3dp"
                android:layout_marginStart="52dp"
                android:layout_marginTop="4dp"
                android:background="#E53935" />

            <!-- INFO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#E6F3FF"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You can update your personal and contact information below."
                    android:textColor="#1687D9"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your student number is protected and cannot be changed here."
                    android:textColor="#687A9B"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- PERSONAL INFORMATION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Personal Information"
                android:textColor="#102D63"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- First name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First Name"
                    android:textColor="#687A9B"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/edit_first_name"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="3dp"
                    android:background="@android:color/transparent"
                    android:hint="Enter your first name"
                    android:inputType="textPersonName|textCapWords"
                    android:padding="0dp"
                    android:textColor="#222222"
                    android:textColorHint="#9AA4B2"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Last name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Name"
                    android:textColor="#687A9B"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/edit_last_name"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="3dp"
                    android:background="@android:color/transparent"
                    android:hint="Enter your last name"
                    android:inputType="textPersonName|textCapWords"
                    android:padding="0dp"
                    android:textColor="#222222"
                    android:textColorHint="#9AA4B2"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Student number locked -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F1F3F6"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Student Number"
                        android:textColor="#687A9B"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 PROTECTED"
                        android:textColor="#8A96A8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/edit_student_number"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp"
                    android:text="000000000"
                    android:textColor="#777777"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Gender -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:textColor="#687A9B"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/edit_gender"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

            <!-- Year -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Year of Study"
                    android:textColor="#687A9B"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/edit_year"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

            <!-- ACADEMIC INFORMATION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Academic Information"
                android:textColor="#102D63"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Programme -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programme"
                    android:textColor="#687A9B"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/edit_programme"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

            <!-- CONTACT INFORMATION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Contact Information"
                android:textColor="#102D63"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="#687A9B"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/edit_email"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="3dp"
                    android:background="@android:color/transparent"
                    android:hint="Enter your email address"
                    android:inputType="textEmailAddress"
                    android:padding="0dp"
                    android:textColor="#222222"
                    android:textColorHint="#9AA4B2"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textColor="#687A9B"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/edit_phone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="3dp"
                    android:background="@android:color/transparent"
                    android:hint="Enter your phone number"
                    android:inputType="phone"
                    android:padding="0dp"
                    android:textColor="#222222"
                    android:textColorHint="#9AA4B2"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- SAVE -->
            <Button
                android:id="@+id/save_profile_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#1687D9"
                android:text="SAVE CHANGES"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- CANCEL -->
            <Button
                android:id="@+id/cancel_edit_profile_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E9F4FC"
                android:text="CANCEL"
                android:textColor="#1687D9"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Your information belongs to you."
                android:textColor="#687A9B"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>