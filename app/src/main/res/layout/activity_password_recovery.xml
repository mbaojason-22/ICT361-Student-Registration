<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".PasswordRecoveryActivity">

    <!-- Campus background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Campus background"
        android:scaleType="centerCrop"
        android:src="@drawable/campus_background"
        android:alpha="0.88" />

    <!-- Soft overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Top navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/recovery_back_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/student_back_circle"
                    android:contentDescription="Back to sign in"
                    android:padding="11dp"
                    android:src="@drawable/student_back_icon" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/recovery_help_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/student_back_circle"
                    android:contentDescription="Password recovery help"
                    android:padding="11dp"
                    android:src="@android:drawable/ic_menu_help" />

            </LinearLayout>

            <!-- REAL CAMPUS COMPANION LOGO -->
            <ImageView
                android:id="@+id/recovery_logo"
                android:layout_width="180dp"
                android:layout_height="70dp"
                android:layout_marginTop="18dp"
                android:contentDescription="Campus Companion logo"
                android:scaleType="fitCenter"
                android:src="@drawable/campus_logo" />

            <!-- Page title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="RESET PASSWORD"
                android:textColor="#1687D9"
                android:textSize="27sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Red underline -->
            <View
                android:layout_width="82dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="#E53935" />

            <!-- WHITE FORM CARD -->
            <LinearLayout
                android:id="@+id/recovery_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Main heading -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Forgot your password?"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <!-- Main explanation -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Enter the email address or phone number linked to your account. We'll use it to verify your identity before you create a new password."
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

                <!-- Contact section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="EMAIL OR PHONE NUMBER"
                    android:textColor="#1687D9"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/recovery_identifier_input"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/student_input"
                    android:hint="Enter email or phone number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:textColor="#222222"
                    android:textColorHint="#666666"
                    android:textSize="15sp" />

                <!-- What happens next -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#F4F8FC"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="WHAT HAPPENS NEXT?"
                        android:textColor="#1687D9"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="We'll send a 6-digit verification code to your registered email or phone number. You'll enter that code on the next screen."
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

                <!-- Security -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#FFF8F8"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SECURITY"
                        android:textColor="#E53935"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Never share your verification code or password with anyone."
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

                <!-- Send code -->
                <Button
                    android:id="@+id/send_recovery_code_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/student_button"
                    android:text="SEND VERIFICATION CODE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <!-- Back -->
                <TextView
                    android:id="@+id/recovery_back_to_sign_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="19dp"
                    android:text="BACK TO SIGN IN"
                    android:textColor="#1687D9"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Same Campus. Brighter Tomorrow."
                android:textColor="#1687D9"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="EDUCATE • CONNECT • GROW"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>