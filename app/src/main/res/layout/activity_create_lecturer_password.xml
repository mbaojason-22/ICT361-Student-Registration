<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Campus background -->
    <ImageView
        android:id="@+id/set_pwd_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/campus_background"
        android:scaleType="centerCrop"
        android:contentDescription="@string/student_campus_background" />

    <!-- Dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000" />

    <!-- Back button -->
    <ImageButton
        android:id="@+id/set_pwd_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/student_back_circle"
        android:src="@drawable/student_back_icon"
        android:padding="12dp"
        android:scaleType="center"
        android:contentDescription="@string/back"
        android:elevation="10dp"
        android:translationZ="10dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Help button -->
    <ImageButton
        android:id="@+id/set_pwd_help_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/help_circle_red"
        android:src="@drawable/help_question_red"
        android:padding="8dp"
        android:scaleType="center"
        android:contentDescription="@string/help"
        android:elevation="10dp"
        android:translationZ="10dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/set_pwd_logo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/campus_companion_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/campus_logo" />

            <!-- Title -->
            <TextView
                android:id="@+id/set_pwd_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/set_password_title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Red line -->
            <View
                android:layout_width="60dp"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#D32F2F" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/set_pwd_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/set_password_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

            <!-- Card container -->
            <LinearLayout
                android:id="@+id/set_pwd_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="20dp">

                <!-- New Password label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:text="@string/new_password_label"
                    android:textColor="#263238"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <!-- New Password box field -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/lecturer_set_pwd_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/student_input"
                        android:drawableStart="@drawable/password_lock_icon_red"
                        android:drawablePadding="10dp"
                        android:hint="@string/enter_new_password_hint"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:textColor="#263238"
                        android:textColorHint="#78909C"
                        android:textSize="14sp"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:fontFamily="sans-serif"
                        android:autofillHints="newPassword" />

                    <!-- Eye button -->
                    <ImageButton
                        android:id="@+id/lecturer_set_pwd_eye"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@android:color/transparent"
                        android:src="@drawable/password_eye_red"
                        android:padding="10dp"
                        android:contentDescription="@string/show_hide_password" />

                </FrameLayout>

                <!-- Confirm Password label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="12dp"
                    android:text="@string/confirm_password_label"
                    android:textColor="#263238"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <!-- Confirm Password box field -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/lecturer_set_confirm_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/student_input"
                        android:drawableStart="@drawable/password_lock_icon_red"
                        android:drawablePadding="10dp"
                        android:hint="@string/enter_confirm_password_hint"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:textColor="#263238"
                        android:textColorHint="#78909C"
                        android:textSize="14sp"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:fontFamily="sans-serif"
                        android:autofillHints="newPassword" />

                    <!-- Eye button -->
                    <ImageButton
                        android:id="@+id/lecturer_set_confirm_eye"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@android:color/transparent"
                        android:src="@drawable/password_eye_red"
                        android:padding="10dp"
                        android:contentDescription="@string/show_hide_password" />

                </FrameLayout>

                <!-- Complete Registration Button -->
                <Button
                    android:id="@+id/complete_registration_button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/lecturer_button"
                    android:text="@string/complete_registration_button"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:padding="0dp"
                    android:textAllCaps="false" />

            </LinearLayout>

            <!-- Motto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/campus_motto"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif"
                android:gravity="center" />

            <!-- Brand words -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/brand_words"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
