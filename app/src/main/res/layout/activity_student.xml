<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Campus background -->
    <ImageView
        android:id="@+id/student_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/campus_background"
        android:scaleType="centerCrop"
        android:contentDescription="@string/student_campus_background" />

    <!-- Slight dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000" />

    <!-- Back button -->
    <ImageButton
        android:id="@+id/student_back_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/student_back_circle"
        android:src="@drawable/student_back_icon"
        android:padding="14dp"
        android:scaleType="center"
        android:contentDescription="@string/back" />

    <!-- Help button -->
    <ImageButton
        android:id="@+id/student_help_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/help_circle"
        android:src="@drawable/help_question"
        android:padding="8dp"
        android:scaleType="center"
        android:contentDescription="@string/help" />

    <!-- Main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Campus Companion logo -->
            <ImageView
                android:id="@+id/student_logo"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/campus_logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/campus_companion_logo" />

            <!-- Portal title -->
            <TextView
                android:id="@+id/student_portal_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/student_portal"
                android:textColor="#1976D2"
                android:textSize="27sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:gravity="center" />

            <!-- Red underline -->
            <View
                android:layout_width="70dp"
                android:layout_height="4dp"
                android:layout_marginTop="7dp"
                android:background="#D32F2F" />

            <!-- Welcome message -->
            <TextView
                android:id="@+id/student_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/welcome_back_student"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:gravity="center" />

            <!-- Login card -->
            <LinearLayout
                android:id="@+id/student_login_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <!-- Student Number or Email label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/student_number_or_email"
                    android:textColor="#263238"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <!-- Student Number or Email field -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="7dp">

                    <EditText
                        android:id="@+id/student_number_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/student_input"
                        android:drawableStart="@drawable/student_user_icon"
                        android:drawablePadding="12dp"
                        android:hint="@string/enter_student_number_or_email"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#263238"
                        android:textColorHint="#78909C"
                        android:textSize="15sp"
                        android:inputType="text"
                        android:singleLine="true"
                        android:fontFamily="sans-serif"
                        android:autofillHints="username" />

                </FrameLayout>

                <!-- Password label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="@string/password"
                    android:textColor="#263238"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <!-- Password field -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="7dp">

                    <EditText
                        android:id="@+id/password_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/student_input"
                        android:drawableStart="@drawable/password_lock_icon"
                        android:drawablePadding="12dp"
                        android:hint="@string/enter_password"
                        android:paddingStart="16dp"
                        android:paddingEnd="52dp"
                        android:textColor="#263238"
                        android:textColorHint="#78909C"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:fontFamily="sans-serif"
                        android:autofillHints="password" />

                    <!-- Password eye -->
                    <ImageButton
                        android:id="@+id/password_eye_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@android:color/transparent"
                        android:src="@drawable/password_eye"
                        android:padding="12dp"
                        android:contentDescription="@string/show_hide_password" />

                </FrameLayout>

                <!-- Forgot password -->
                <TextView
                    android:id="@+id/forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="9dp"
                    android:text="@string/forgot_password"
                    android:textColor="#1976D2"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Sign in button -->
                <Button
                    android:id="@+id/sign_in_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/student_button"
                    android:text="@string/sign_in"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:padding="0dp"
                    android:textAllCaps="false" />

                <!-- OR divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#B0BEC5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/or"
                        android:textColor="#607D8B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#B0BEC5" />

                </LinearLayout>

                <!-- Create account button -->
                <Button
                    android:id="@+id/create_account_button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/create_account_button"
                    android:text="@string/create_account"
                    android:textColor="#D32F2F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:padding="0dp"
                    android:textAllCaps="false" />

            </LinearLayout>

            <!-- Motto -->
            <TextView
                android:id="@+id/student_motto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="@string/campus_motto"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="italic"
                android:fontFamily="sans-serif"
                android:gravity="center" />

            <!-- Brand words -->
            <TextView
                android:id="@+id/student_brand_words"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/brand_words"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>