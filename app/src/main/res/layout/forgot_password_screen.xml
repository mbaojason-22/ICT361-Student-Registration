<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ForgotPasswordActivity">

    <ImageView
        android:id="@+id/forgot_password_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Campus background"
        android:scaleType="centerCrop"
        android:src="@drawable/campus_background"
        android:alpha="0.88" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- TOP NAVIGATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/forgot_password_back_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/student_back_circle"
                    android:contentDescription="Back to sign in"
                    android:padding="11dp"
                    android:src="@drawable/student_back_icon" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/forgot_password_help_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/student_back_circle"
                    android:contentDescription="Forgot password help"
                    android:padding="11dp"
                    android:src="@android:drawable/ic_menu_help" />

            </LinearLayout>

            <!-- REAL CAMPUS COMPANION LOGO -->
            <ImageView
                android:id="@+id/forgot_password_logo"
                android:layout_width="110dp"
                android:layout_height="70dp"
                android:layout_marginTop="22dp"
                android:contentDescription="Campus Companion Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/campus_logo" />

            <!-- TITLE -->
            <TextView
                android:id="@+id/forgot_password_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="RESET PASSWORD"
                android:textColor="#1687D9"
                android:textSize="27sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- RED UNDERLINE -->
            <View
                android:layout_width="82dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="#E53935" />



            <!-- MAIN FORM -->
            <LinearLayout
                android:id="@+id/forgot_password_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- IMPORTANT INFORMATION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Forgot your password?"
                    android:textColor="#1687D9"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/forgot_password_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Enter your student number or the email or phone number linked to your account. We'll send you a verification code."
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />

                <!-- INPUT LABEL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="Student Number or Email / Phone"
                    android:textColor="#1687D9"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/recovery_identifier_input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/student_input"
                    android:hint="Enter student number or email/phone"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="#222222"
                    android:textColorHint="#888888"
                    android:textSize="15sp"
                    android:inputType="text" />

                <!-- IMPORTANT SECURITY INFORMATION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:text="We'll use your registered contact information to verify your identity."
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />

                <!-- SEND CODE -->
                <Button
                    android:id="@+id/send_recovery_code_button"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="21dp"
                    android:background="@drawable/student_button"
                    android:text="SEND VERIFICATION CODE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

            </LinearLayout>

            <!-- BACK TO SIGN IN -->
            <TextView
                android:id="@+id/back_to_sign_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="BACK TO SIGN IN"
                android:textColor="#1687D9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- SECURITY NOTE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="For your security, never share your verification code or password with anyone."
                android:textColor="#555555"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

            <!-- FOOTER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Same Campus. Brighter Tomorrow."
                android:textColor="#1687D9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="EDUCATE  •  CONNECT  •  GROW"
                android:textColor="#E53935"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>