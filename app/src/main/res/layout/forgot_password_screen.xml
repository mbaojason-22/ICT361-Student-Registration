<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ForgotPasswordActivity">

    <!-- Campus background -->
    <ImageView
        android:id="@+id/forgot_password_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/student_campus_background"
        android:scaleType="centerCrop"
        android:src="@drawable/campus_background" />

    <!-- Dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000" />

    <!-- Back button -->
    <ImageButton
        android:id="@+id/forgot_password_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/student_back_circle"
        android:src="@drawable/student_back_icon"
        android:padding="12dp"
        android:scaleType="center"
        android:contentDescription="@string/back"
        android:elevation="10dp"
        android:translationZ="10dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Help button (Red help icon) -->
    <ImageButton
        android:id="@+id/forgot_password_help_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/help_circle_red"
        android:src="@drawable/help_question_red"
        android:padding="8dp"
        android:scaleType="center"
        android:contentDescription="@string/help"
        android:elevation="10dp"
        android:translationZ="10dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Campus Companion logo -->
            <ImageView
                android:id="@+id/forgot_password_logo"
                android:layout_width="95dp"
                android:layout_height="95dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:src="@drawable/campus_logo"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/campus_companion_logo" />

            <!-- Title -->
            <TextView
                android:id="@+id/forgot_password_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESET PASSWORD"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:gravity="center" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/forgot_password_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:text="Enter your credentials to recover your lecturer account"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

            <!-- Main Form Card -->
            <LinearLayout
                android:id="@+id/forgot_password_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="20dp">

                <!-- Instruction text inside card -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Forgot your lecturer password?"
                    android:textColor="#263238"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/forgot_password_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Enter your lecturer ID or registered email address linked to your account. We'll send you a verification code."
                    android:textColor="#37474F"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />

                <!-- Input Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="14dp"
                    android:text="Lecturer ID or Registered Email"
                    android:textColor="#263238"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <!-- Input Field with Red Icon -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp">

                    <EditText
                        android:id="@+id/recovery_identifier_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/student_input"
                        android:drawableStart="@drawable/student_user_icon_red"
                        android:drawablePadding="10dp"
                        android:hint="Enter lecturer ID or email"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#263238"
                        android:textColorHint="#78909C"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:singleLine="true"
                        android:fontFamily="sans-serif"
                        android:autofillHints="username" />

                </FrameLayout>

                <!-- Send Code Button (Lecturer layout red button with white font) -->
                <Button
                    android:id="@+id/send_recovery_code_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/lecturer_button"
                    android:text="SEND VERIFICATION CODE"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:padding="0dp"
                    android:textAllCaps="false" />

            </LinearLayout>

            <!-- Back to Sign In Link -->
            <TextView
                android:id="@+id/back_to_sign_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="BACK TO SIGN IN"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true" />

            <!-- Motto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/campus_motto"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold|italic"
                android:fontFamily="sans-serif"
                android:gravity="center" />

            <!-- Brand words -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/brand_words"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
