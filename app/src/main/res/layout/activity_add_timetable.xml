<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/add_timetable_back_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Back"
            android:textColor="#102D63"
            android:textSize="16sp"
            android:contentDescription="Go back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Add Timetable Class"
            android:textColor="#102D63"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Enter the course details below."
            android:textColor="#687A9B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Course code"
            android:textColor="#102D63" />

        <EditText
            android:id="@+id/course_code_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="14dp"
            android:hint="e.g. ICT361"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:backgroundTint="#1687D9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Course name"
            android:textColor="#102D63" />

        <EditText
            android:id="@+id/course_name_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="14dp"
            android:hint="e.g. Mobile Application Programming"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:backgroundTint="#1687D9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Day"
            android:textColor="#102D63" />

        <Spinner
            android:id="@+id/day_spinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start time"
            android:textColor="#102D63" />

        <EditText
            android:id="@+id/start_time_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="14dp"
            android:hint="Select start time"
            android:focusable="false"
            android:clickable="true"
            android:padding="12dp"
            android:backgroundTint="#1687D9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End time"
            android:textColor="#102D63" />

        <EditText
            android:id="@+id/end_time_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="14dp"
            android:hint="Select end time"
            android:focusable="false"
            android:clickable="true"
            android:padding="12dp"
            android:backgroundTint="#1687D9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Venue"
            android:textColor="#102D63" />

        <EditText
            android:id="@+id/venue_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="14dp"
            android:hint="e.g. Computer Lab 2"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:backgroundTint="#1687D9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class type"
            android:textColor="#102D63" />

        <Spinner
            android:id="@+id/class_type_spinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programme"
            android:textColor="#102D63" />

        <EditText
            android:id="@+id/programme_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="24dp"
            android:hint="e.g. Computer Science"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:backgroundTint="#1687D9" />

        <Button
            android:id="@+id/save_timetable_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Save Timetable Class"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
