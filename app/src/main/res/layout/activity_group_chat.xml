<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/group_chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9FD">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back button -->
        <TextView
            android:id="@+id/back_button"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#1687D9"
            android:textSize="38sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Group information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/group_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G02 Lab Group"
                android:textColor="#102D63"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/group_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="8 members • Your lab group"
                android:textColor="#71809A"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Group info button -->
        <TextView
            android:id="@+id/group_info_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="ⓘ"
            android:textColor="#1687D9"
            android:textSize="25sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>


    <!-- Messages -->
    <ScrollView
        android:id="@+id/messages_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/chat_header"
        app:layout_constraintBottom_toTopOf="@id/message_input_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/messages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Date -->
            <TextView
                android:id="@+id/today_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="TODAY"
                android:textColor="#71809A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/student_login_panel" />

            <!-- Lecturer notice -->
            <TextView
                android:id="@+id/notice_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="18dp"
                android:maxWidth="310dp"
                android:padding="14dp"
                android:text="Lecturer Notice&#10;&#10;Remember to coordinate your ICT361 group submission."
                android:textColor="#102D63"
                android:textSize="13sp"
                android:background="@drawable/student_login_panel" />

            <!-- Other member message -->
            <LinearLayout
                android:id="@+id/member_message_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/member_message_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Michael K."
                    android:textColor="#1687D9"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/member_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="290dp"
                    android:padding="13dp"
                    android:text="Hey guys, are we meeting after class today?"
                    android:textColor="#102D63"
                    android:textSize="14sp"
                    android:background="@drawable/student_login_panel" />

                <TextView
                    android:id="@+id/member_message_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="3dp"
                    android:text="14:02"
                    android:textColor="#8996AA"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- Another member message -->
            <LinearLayout
                android:id="@+id/member_message_layout_two"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/member_message_name_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amanda N."
                    android:textColor="#E53935"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/member_message_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="290dp"
                    android:padding="13dp"
                    android:text="Yes, 14:00 works for me."
                    android:textColor="#102D63"
                    android:textSize="14sp"
                    android:background="@drawable/student_login_panel" />

                <TextView
                    android:id="@+id/member_message_time_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="3dp"
                    android:text="14:05"
                    android:textColor="#8996AA"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- My message -->
            <LinearLayout
                android:id="@+id/my_message_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/my_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="290dp"
                    android:padding="13dp"
                    android:text="Perfect. I'll be there."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@drawable/student_button" />

                <TextView
                    android:id="@+id/my_message_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="3dp"
                    android:text="14:07 ✓"
                    android:textColor="#8996AA"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- Message input -->
    <LinearLayout
        android:id="@+id/message_input_area"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Attach button -->
        <TextView
            android:id="@+id/attach_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#1687D9"
            android:textSize="26sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Message field -->
        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/student_login_panel"
            android:hint="Message your lab group..."
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#102D63"
            android:textColorHint="#8996AA"
            android:textSize="14sp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" />

        <!-- Send button -->
        <TextView
            android:id="@+id/send_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/student_button"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>