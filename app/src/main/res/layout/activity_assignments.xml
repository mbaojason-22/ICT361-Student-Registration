<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/assignments_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF4FA"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    tools:context=".AssignmentsActivity">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/student_back_circle"
            android:gravity="center"
            android:text="‹"
            android:textColor="#102D63"
            android:textSize="32sp"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Assignments"
            android:textColor="#102D63"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- INTRO -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stay on top of your coursework and deadlines."
        android:textColor="#52678F"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <!-- FILTER BUTTONS -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ALL -->

            <TextView
                android:id="@+id/filter_all"
                android:layout_width="86dp"
                android:layout_height="44dp"
                android:background="@drawable/student_button"
                android:gravity="center"
                android:text="ALL"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Show all assignments" />

            <!-- PENDING -->

            <TextView
                android:id="@+id/filter_pending"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/student_login_panel"
                android:gravity="center"
                android:text="PENDING"
                android:textColor="#102D63"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Show pending assignments" />

            <!-- SUBMITTED -->

            <TextView
                android:id="@+id/filter_submitted"
                android:layout_width="110dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/student_login_panel"
                android:gravity="center"
                android:text="SUBMITTED"
                android:textColor="#102D63"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Show submitted assignments" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- ASSIGNMENT LIST -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/assignments_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        </LinearLayout>

    </ScrollView>

</LinearLayout>