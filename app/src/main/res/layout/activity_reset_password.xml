<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Campus background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Campus background"
        android:scaleType="centerCrop"
        android:src="@drawable/campus_background"
        android:alpha="0.88" />

    <!-- Soft overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <!-- Brand -->
            <ImageView
                android:id="@+id/reset_password_logo"
                android:layout_width="110dp"
                android:layout_height="70dp"
                android:layout_marginTop="35dp"
                android:contentDescription="Campus Companion Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/campus_logo" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="CREATE NEW PASSWORD"
                android:textColor="#1687D9"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Red underline -->
            <View
                android:layout_width="82dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="#E53935" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Create a new password for your Campus Companion account."
                android:textColor="#333333"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />

            <!-- WHITE FORM -->
            <LinearLayout
                android:id="@+id/reset_password_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/student_login_panel"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- NEW PASSWORD -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NEW PASSWORD"
                    android:textColor="#1687D9"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/new_password_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/student_input"
                        android:hint="Create a new password"
                        android:paddingStart="16dp"
                        android:paddingEnd="54dp"
                        android:singleLine="true"
                        android:inputType="textPassword"
                        android:textColor="#222222"
                        android:textColorHint="#666666"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/new_password_eye_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@android:color/transparent"
                        android:contentDescription="Show or hide new password"
                        android:padding="13dp"
                        android:src="@drawable/password_eye" />

                </FrameLayout>

                <!-- PASSWORD STRENGTH -->
                <TextView
                    android:id="@+id/new_password_strength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Password strength: Not set"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- PASSWORD GUIDANCE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Use at least 8 characters with uppercase and lowercase letters, a number and a special character."
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <!-- CONFIRM PASSWORD -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="CONFIRM NEW PASSWORD"
                    android:textColor="#1687D9"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/confirm_new_password_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/student_input"
                        android:hint="Re-enter your new password"
                        android:paddingStart="16dp"
                        android:paddingEnd="54dp"
                        android:singleLine="true"
                        android:inputType="textPassword"
                        android:textColor="#222222"
                        android:textColorHint="#666666"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/confirm_new_password_eye_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@android:color/transparent"
                        android:contentDescription="Show or hide confirmed password"
                        android:padding="13dp"
                        android:src="@drawable/password_eye" />

                </FrameLayout>

                <!-- SECURITY WARNING -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#F4F8FC"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PASSWORD SAFETY"
                        android:textColor="#1687D9"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Never share your password with anyone. Campus Companion will never ask you to send your password to another person."
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

                <!-- UPDATE PASSWORD -->
                <Button
                    android:id="@+id/update_password_button"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/student_button"
                    android:text="UPDATE PASSWORD"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Same Campus. Brighter Tomorrow."
                android:textColor="#1687D9"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="EDUCATE • CONNECT • GROW"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>