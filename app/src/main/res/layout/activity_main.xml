<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CAMPUS BACKGROUND -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/campus_background"
        android:scaleType="centerCrop"
        android:contentDescription="Campus background" />

    <!-- DARK TRANSPARENT OVERLAY -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#18000000" />

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="42dp"
            android:paddingBottom="35dp">


            <!-- HELP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Help"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/helpIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/help_circle"
                    android:src="@drawable/help_question"
                    android:scaleType="centerInside"
                    android:padding="9dp"
                    android:contentDescription="Help" />

            </LinearLayout>


            <!-- GLASS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:background="@drawable/glass_panel">


                <!-- LOGO -->
                <ImageView
                    android:id="@+id/campusLogo"
                    android:layout_width="165dp"
                    android:layout_height="165dp"
                    android:src="@drawable/campus_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Campus Companion logo" />


                <!-- WELCOME -->
                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome!"
                    android:textColor="#123A78"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:gravity="center" />


                <!-- RED LINE -->
                <View
                    android:layout_width="100dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/red_line" />


                <!-- DESCRIPTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Your academic journey,\nour support."
                    android:textColor="#536B8A"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />


                <!-- BUTTONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="32dp">


                    <!-- STUDENT BUTTON -->
                    <Button
                        android:id="@+id/studentButton"
                        android:layout_width="match_parent"
                        android:layout_height="66dp"
                        android:background="@drawable/student_button"
                        android:drawableStart="@drawable/student_icon"
                        android:drawablePadding="15dp"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="18dp"
                        android:text="I'm a Student        ›"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null" />


                    <!-- LECTURER BUTTON -->
                    <Button
                        android:id="@+id/lecturerButton"
                        android:layout_width="match_parent"
                        android:layout_height="66dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/lecturer_button"
                        android:drawableStart="@drawable/lecturer_icon"
                        android:drawablePadding="15dp"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="18dp"
                        android:text="I'm a Lecturer        ›"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null" />

                </LinearLayout>


                <!-- BOTTOM WORDS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="EDUCATE  •  CONNECT  •  GROW"
                    android:textColor="#123A78"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:gravity="center" />

            </LinearLayout>


            <!-- MOTTO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Same Campus. Brighter Tomorrow."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold|italic"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>